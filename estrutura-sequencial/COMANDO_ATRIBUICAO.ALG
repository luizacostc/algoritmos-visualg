Algoritmo "comando_atribuicao"

Var
    x, y : inteiro
    b1, b2, h, area : real
    a, b, resultado : inteiro
    c : real
    d : inteiro



Inicio
    x <- 5
    y <- 2 * x
    
    escreval(x)
    escreval(y)
    
    b1 <- 6.0
    b2<- 8.0
    h <- 5.0
    
    area <- (b1 + b2) / 2.0 * h
    
    escreval(area)
    
    a <- 5
    b <- 2
    
    resultado <- a \ b
    
    escreval(resultado)
    
    c <- 7.2
    d <- Int(c)
    
    escreval(d)
    
    



Fimalgoritmo