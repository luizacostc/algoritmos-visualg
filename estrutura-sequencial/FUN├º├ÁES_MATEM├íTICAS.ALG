Algoritmo "funções_matemáticas"

Var
    x, y, z, a, b, c, d : real
    x1, x2, delta : inteiro



Inicio
    x <- 2.0
    y <- 3.0
    z <- -7.0
    
    a <- Exp(x, y)
    b <- RaizQ(y)
    c <- Pi
    d <- Abs(z)
    
    escreval(a)
    escreval(b)
    escreval(c)
    escreval(d)



Fimalgoritmo