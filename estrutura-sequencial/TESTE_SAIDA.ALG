Algoritmo "teste_saida"

Var

   a : inteiro
   b : real
   c : caractere
   d : logico

Inicio

  a <- 32
  b <- 2.34567
  c <- "Bom dia!"
  d <- VERDADEIRO
  
  escreval(a)
  escreval(b)
  escreval(b:10)
  escreval(b:9)
  escreval(b:8)
  escreval(b:7)
  escreval(b:6)
  escreval(b:5)
  escreval(b:4)
  escreval(b:3)
  escreval(b:2)
  escreval(b:1)
  escreval(b:10:2)
  escreval(c)
  escreval(d)

Fimalgoritmo